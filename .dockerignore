# Keep the build context small and secrets out of images.
**/node_modules
**/dist
.git
**/.env
**/.env.*
!**/.env.example
**/*.log
**/*.tsbuildinfo

# Generated or local-only state (rebuilt inside the image)
frontend/.next
frontend/out

# Not needed to build or run the app
docs
*.html
README.md
Dockerfile
docker-compose.yml
.dockerignore
backend/src/generated
neon.ts
.neon
