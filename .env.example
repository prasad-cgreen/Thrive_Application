# Build settings for `docker compose build` (copy to .env next to docker-compose.yml).
# These are compiled into the web app's browser code, so rebuild the web image after changing them.
# Server secrets do not go here: they live in backend/.env.
# Local dev: put these in frontend/.env.local instead (the API defaults to http://127.0.0.1:4200/api/v1).

# Public address of the API, including /api/v1 (the site is xthrive.ai)
NEXT_PUBLIC_API_URL=https://api.xthrive.ai/api/v1
# Cloudflare Turnstile site key (public). Blank = no captcha widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Relive's address, for the "overdue dues? Explore help through Relive" link (not for login).
NEXT_PUBLIC_RELIVE_URL=https://relive.co.in
# Google Tag Manager container id (public), carries Google Analytics. Leave the line out to use xThrive's
# container (GTM-KP4KGD5M); set it blank to build without tracking.
# NEXT_PUBLIC_GTM_ID=GTM-KP4KGD5M
